# Local standalone API port. Vercel invokes the exported Express app directly.
PORT=5001

# Use a local MongoDB instance for development, or set the Atlas URI in the
# Backend service's Vercel environment settings. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/beachsafety

# Optional for local cross-origin development. Same-domain Vercel requests
# do not require CORS configuration.
CLIENT_ORIGIN=http://localhost:5173
