# Local API port. Render supplies PORT automatically in production.
PORT=5001

# Use a local MongoDB instance for development, or replace with your
# MongoDB Atlas connection string. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/beachsafety

# Comma-separated allowed browser origins. Set this to your exact Vercel
# production origin in Render (for example, https://your-app.vercel.app).
CLIENT_ORIGIN=http://localhost:5173
